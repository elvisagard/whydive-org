{
  "name": "agard-base",
  "version": "1.0.0",
  "description": "Monorepo for Agard Base project",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive clean",
    "frontend:dev": "pnpm --filter frontend dev",
    "backend:dev": "pnpm --filter backend dev",
    "frontend:build": "pnpm --filter frontend build",
    "backend:build": "pnpm --filter backend build",
    "assets:sync:r2": "bash scripts/sync-r2-assets.sh",
    "db:migrate": "bash scripts/db-migrate.sh"
  },
  "keywords": ["monorepo", "fullstack", "nextjs"],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "frontend",
    "backend"
  ]
}
